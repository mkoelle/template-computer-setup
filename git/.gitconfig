[user]
  name = Mark Koelle
  email = mkoelle@gmail.com

[core]
  editor = code --wait
  excludesfile = ~/.gitignore_global
  preloadIndex = true
  fscache = true

[merge]
  tool = code
  conflictStyle = zdiff3

[mergetool "code"]
  cmd = code --wait --merge $REMOTE $LOCAL $BASE $MERGED

[fetch]
  prune = true

[pull]
  rebase = true
  ff = only

[push]
  default = current
  autoSetupRemote = true

[diff]
  colorMoved = zebra
  mnemonicPrefix = true
  algorithm = histogram
  indentHeuristic = true

[rebase]
  autoStash = true
  autoSquash = true

[branch]
  autoSetupMerge = always
  autoSetupRebase = always

[pretty]
  pretty-history = format:%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset

[help]
  autocorrect = prompt

[gc]
  writeCommitGraph = true

[alias]
  changelog = show --name-only
  changes = log --oneline --decorate --stat
  commitnumber = "!git log --pretty=oneline | wc -l"
  ph = prettyhistory
  prettyhistory = log --graph --pretty=pretty-history --abbrev-commit --date=relative
  ql = quicklog
  quicklog = log --pretty=format:'%Cblue%h %Cred%cD %Creset%cn %Cgreen%s%Creset' --date-order --graph
  undo = reset --soft HEAD~1
  unstage = reset HEAD
  username = config --get user.name
  fix = commit --fixup HEAD
  rc = rebase --continue
  ra = rebase --abort
  rs = rebase --skip
[alias]
  # Keep this name (do NOT call it `prune`): avoids collision with real `git prune`. [2](https://www.systutorials.com/linux-manual-page-1-git-for-each-ref/)
  prune-origin = fetch --prune origin

  # 1) list-gone: branches whose configured upstream is missing ([gone]) [1](https://gist.github.com/onildoaguiar/fcb5b82f883f6c2aa0153c55f3235e87?permalink_comment_id=3949725)

  list-gone = "!f(){ git prune-origin >/dev/null 2>&1; cur=$(git branch --show-current 2>/dev/null); git for-each-ref --format='%(refname:short)%09%(upstream:track)' refs/heads | awk -F '\\t' -v cur=\"$cur\" '$1!=cur && $2==\"[gone]\" {print $1}'; }; f"

  # 2) list-local-only:
  #    branches that are NOT on the remote in the practical sense:
  #      - no upstream configured, OR
  #      - upstream tracks a local branch (not refs/remotes/…), OR
  #      - upstream configured but gone ([gone])
  #
  #    NOTE: This is intentionally a superset of list-gone.
  list-local-only = "!f(){ git prune-origin >/dev/null 2>&1; cur=$(git branch --show-current 2>/dev/null); git for-each-ref --format='%(refname:short)%09%(upstream)%09%(upstream:track)' refs/heads | awk -F '\\t' -v cur=\"$cur\" '$1!=cur && ($2==\"\" || $2!~/^refs\\/remotes\\// || $3==\"[gone]\") {print $1}'; }; f"

  # 3) nuke: delete branches passed as args OR via stdin (portable; no xargs flags)
  nuke = "!f(){ \
    del(){ git branch -D -- \"$1\"; }; \
    if [ \"$#\" -gt 0 ]; then \
      for b in \"$@\"; do [ -n \"$b\" ] && del \"$b\"; done; \
    else \
      while IFS= read -r b; do [ -n \"$b\" ] && del \"$b\"; done; \
    fi; \
  }; f"

  # 4) nuke-gone: prints what will be deleted, then deletes (no confirmation)
  nuke-gone = "!f(){ \
    br=$(git list-gone); \
    [ -z \"$br\" ] && echo \"No gone branches.\" && exit 0; \
    echo \"$br\"; \
    printf '%s\n' \"$br\" | git nuke; \
  }; f"

  # 5) nuke-local-only: prints what will be deleted, then deletes (no confirmation)
  nuke-local-only = "!f(){ \
    br=$(git list-local-only); \
    [ -z \"$br\" ] && echo \"No local-only branches.\" && exit 0; \
    echo \"$br\"; \
    printf '%s\n' \"$br\" | git nuke; \
  }; f"
