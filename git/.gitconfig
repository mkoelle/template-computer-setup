[user]
  name = Mark Koelle
  email = mkoelle@gmail.com

[core]
  editor = code --wait
  excludesfile = ~/.gitignore_global
  preloadIndex = true
  fscache = true

[merge]
  tool = code
  conflictStyle = zdiff3

[mergetool "code"]
  cmd = code --wait --merge $REMOTE $LOCAL $BASE $MERGED

[fetch]
  prune = true

[pull]
  rebase = true
  ff = only

[push]
  default = current
  autoSetupRemote = true

[diff]
  colorMoved = zebra
  mnemonicPrefix = true
  algorithm = histogram
  indentHeuristic = true

[rebase]
  autoStash = true
  autoSquash = true

[branch]
  autoSetupMerge = always
  autoSetupRebase = always

[pretty]
  pretty-history = format:%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset

[help]
  autocorrect = prompt

[gc]
  writeCommitGraph = true

[alias]
  changelog = show --name-only
  changes = log --oneline --decorate --stat
  commitnumber = "!git log --pretty=oneline | wc -l"
  ph = prettyhistory
  prettyhistory = log --graph --pretty=pretty-history --abbrev-commit --date=relative
  ql = quicklog
  quicklog = log --pretty=format:'%Cblue%h %Cred%cD %Creset%cn %Cgreen%s%Creset' --date-order --graph
  undo = reset --soft HEAD~1
  unstage = reset HEAD
  username = config --get user.name
  fix = commit --fixup HEAD
  rc = rebase --continue
  ra = rebase --abort
  rs = rebase --skip
[alias]
  # Prune remote-tracking branches (safe name; doesn't collide with `git prune`)
  prune-origin = fetch --prune origin

  # Determine default branch name (origin/HEAD -> main/master/etc), with safe fallbacks
  default-branch = "!f(){ \
    b=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null | sed 's@^origin/@@'); \
    [ -n \"$b\" ] || b=$(git symbolic-ref --quiet --short HEAD 2>/dev/null); \
    [ -n \"$b\" ] || b=$(git for-each-ref --sort=-committerdate --format='%(refname:short)' refs/heads | head -n1); \
    printf '%s\n' \"$b\"; \
  }; f"

  # List local branches merged into the default branch (not into "current branch")
  list-merged = "!f(){ \
    db=$(git default-branch); \
    base=\"$db\"; \
    git show-ref --verify --quiet \"refs/remotes/origin/$db\" && base=\"origin/$db\"; \
    git for-each-ref --merged \"$base\" --format='%(refname:short)' refs/heads \
      | grep -Ev \"^(\"$db\"|main|master|dev|prod|trunk|develop)$\"; \
  }; f"

  # List branches whose upstream is gone (robust; avoids parsing `git branch -vv`)
  list-gone = "!git for-each-ref --format='%(refname:short) %(upstream:track)' refs/heads \
    | awk '$2==\"[gone]\" {print $1}'"

  # List branches that have no upstream configured at all (true local-only)
  list-no-upstream = "!git for-each-ref --format='%(refname:short) %(upstream:short)' refs/heads \
    | awk '$2==\"\" {print $1}'"

  # List branches that do not exist on origin by name (portable; no process substitution)
  list-local-only = "!f(){ \
    t1=$(mktemp 2>/dev/null || mktemp -t gitbr); \
    t2=$(mktemp 2>/dev/null || mktemp -t gitbr); \
    git for-each-ref --format='%(refname:short)' refs/heads | sort >\"$t1\"; \
    git for-each-ref --format='%(refname:short)' refs/remotes/origin \
      | sed 's@^origin/@@' | grep -v '^HEAD$' | sort >\"$t2\"; \
    comm -23 \"$t1\" \"$t2\"; \
    rm -f \"$t1\" \"$t2\"; \
  }; f"

  # Rollups (these are the “what would be nuked” lists)
  list-stale = "!f(){ (git list-merged; git list-gone) | sort -u; }; f"
  list-all-nukable = "!f(){ (git list-stale; git list-local-only) | sort -u; }; f"

  # Core deleter: accepts args OR stdin; no xargs portability issues; no prompts
  nuke = "!f(){ \
    del(){ git branch -D -- \"$1\"; }; \
    if [ \"$#\" -gt 0 ]; then \
      for b in \"$@\"; do [ -n \"$b\" ] && del \"$b\"; done; \
    else \
      while IFS= read -r b; do [ -n \"$b\" ] && del \"$b\"; done; \
    fi; \
  }; f"

  # Non-interactive nukes (they PRINT what they'll delete, then delete)
  nuke-merged = "!f(){ git prune-origin >/dev/null; br=$(git list-merged); \
    [ -z \"$br\" ] && echo \"No merged branches.\" && exit 0; \
    echo \"$br\"; echo \"$br\" | git nuke; \
  }; f"

  nuke-gone = "!f(){ git prune-origin >/dev/null; br=$(git list-gone); \
    [ -z \"$br\" ] && echo \"No gone branches.\" && exit 0; \
    echo \"$br\"; echo \"$br\" | git nuke; \
  }; f"

  nuke-local-only = "!f(){ br=$(git list-local-only); \
    [ -z \"$br\" ] && echo \"No local-only branches.\" && exit 0; \
    echo \"$br\"; echo \"$br\" | git nuke; \
  }; f"

  nuke-stale = "!f(){ git prune-origin >/dev/null; br=$(git list-stale); \
    [ -z \"$br\" ] && echo \"No stale branches.\" && exit 0; \
    echo \"$br\"; echo \"$br\" | git nuke; \
  }; f"

  nuke-all = "!f(){ git prune-origin >/dev/null; br=$(git list-all-nukable); \
    [ -z \"$br\" ] && echo \"No branches to delete.\" && exit 0; \
    echo \"$br\"; echo \"$br\" | git nuke; \
  }; f"
