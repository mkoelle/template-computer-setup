#!/usr/bin/env python3
"""
git-org: clone/sync all repos for an org/group into a Go-like workspace layout.

Layout:
  ~/src/<host>/<team>/<repo>

Examples:
  git-org clone github my-org --proto ssh
  git-org clone gitlab platform/observability --host gitlab.com --proto https
  git-org list  github my-org
  git-org sync  github my-org

Auth (recommended) via env vars:
  GITHUB_TOKEN  - GitHub API
  GITLAB_TOKEN  - GitLab API
"""

from __future__ import annotations

import argparse
import json
import os
import pathlib
import subprocess
import sys
import time
import urllib.parse
import urllib.request


def eprint(*args, **kwargs):
    print(*args, file=sys.stderr, **kwargs)


def http_json(url: str, headers: dict[str, str], timeout: int = 30):
    req = urllib.request.Request(url, headers=headers)
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        body = resp.read()
        return json.loads(body.decode("utf-8"))


def run(cmd: list[str], cwd: pathlib.Path | None = None):
    p = subprocess.Popen(cmd, cwd=str(cwd) if cwd else None)
    rc = p.wait()
    if rc != 0:
        raise RuntimeError(f"Command failed ({rc}): {' '.join(cmd)}")


def ensure_dir(p: pathlib.Path):
    p.mkdir(parents=True, exist_ok=True)


def git_clone_or_fetch(repo_url: str, dest: pathlib.Path):
    if dest.exists() and (dest / ".git").exists():
        eprint(f"[fetch] {dest}")
        run(["git", "-C", str(dest), "fetch", "--all", "--prune"])
        return

    ensure_dir(dest.parent)
    eprint(f"[clone] {repo_url} -> {dest}")
    run(["git", "clone", repo_url, str(dest)])


class Provider:
    name: str

    def __init__(self, host: str, token: str | None, proto: str):
        self.host = host
        self.token = token
        self.proto = proto  # ssh|https

    def list_repos(self, team: str) -> list[dict]:
        raise NotImplementedError

    def pick_clone_url(self, repo: dict) -> str:
        raise NotImplementedError


class GitHubProvider(Provider):
    name = "github"

    def list_repos(self, team: str) -> list[dict]:
        headers = {
            "Accept": "application/vnd.github+json",
            "User-Agent": "git-org",
        }
        if self.token:
            headers["Authorization"] = f"Bearer {self.token}"

        base = "https://api.github.com"
        per_page = 100
        repos: list[dict] = []

        def fetch_all(url0: str):
            url = url0
            while True:
                data = http_json(url, headers=headers)
                if not isinstance(data, list):
                    raise RuntimeError(f"Unexpected GitHub response: {data}")
                repos.extend(data)
                if len(data) < per_page:
                    break

                # paginate via page=
                parsed = urllib.parse.urlparse(url)
                qs = urllib.parse.parse_qs(parsed.query)
                page = int(qs.get("page", ["1"])[0])
                qs["page"] = [str(page + 1)]
                new_q = urllib.parse.urlencode({k: v[0] for k, v in qs.items()})
                url = parsed._replace(query=new_q).geturl()

        # Try org first; fallback to user
        org_url = f"{base}/orgs/{urllib.parse.quote(team)}/repos?per_page={per_page}&page=1&type=all"
        user_url = f"{base}/users/{urllib.parse.quote(team)}/repos?per_page={per_page}&page=1&type=all"

        try:
            fetch_all(org_url)
        except Exception as ex:
            repos.clear()
            try:
                fetch_all(user_url)
            except Exception:
                raise RuntimeError(
                    f"Failed listing GitHub repos for '{team}' as org or user. "
                    f"Org attempt error: {ex}"
                )

        return repos

    def pick_clone_url(self, repo: dict) -> str:
        return repo["ssh_url"] if self.proto == "ssh" else repo["clone_url"]


class GitLabProvider(Provider):
    name = "gitlab"

    def list_repos(self, team: str) -> list[dict]:
        if not self.host:
            raise RuntimeError("GitLab host is required (e.g., gitlab.com or gitlab.myco.com)")

        headers = {"User-Agent": "git-org"}
        if self.token:
            headers["PRIVATE-TOKEN"] = self.token

        per_page = 100
        projects: list[dict] = []
        base = f"https://{self.host}/api/v4"

        group = urllib.parse.quote(team, safe="")
        url = (
            f"{base}/groups/{group}/projects"
            f"?include_subgroups=true&per_page={per_page}&page=1&simple=true"
        )

        while True:
            data = http_json(url, headers=headers)
            if not isinstance(data, list):
                raise RuntimeError(f"Unexpected GitLab response: {data}")
            projects.extend(data)
            if len(data) < per_page:
                break

            parsed = urllib.parse.urlparse(url)
            qs = urllib.parse.parse_qs(parsed.query)
            page = int(qs.get("page", ["1"])[0])
            qs["page"] = [str(page + 1)]
            new_q = urllib.parse.urlencode({k: v[0] for k, v in qs.items()})
            url = parsed._replace(query=new_q).geturl()
            time.sleep(0.05)  # be gentle on self-hosted

        return projects

    def pick_clone_url(self, repo: dict) -> str:
        return repo["ssh_url_to_repo"] if self.proto == "ssh" else repo["http_url_to_repo"]


PROVIDERS = {
    "github": GitHubProvider,
    "gitlab": GitLabProvider,
}


def resolve_provider(provider_name: str, host: str | None, proto: str) -> Provider:
    if provider_name not in PROVIDERS:
        raise RuntimeError(f"Unknown provider: {provider_name}")

    # Defaults
    if not host:
        host = "github.com" if provider_name == "github" else "gitlab.com"

    token = None
    if provider_name == "github":
        token = os.environ.get("GITHUB_TOKEN")
    elif provider_name == "gitlab":
        token = os.environ.get("GITLAB_TOKEN")

    return PROVIDERS[provider_name](host=host, token=token, proto=proto)


def repo_name(repo: dict) -> str:
    return repo.get("name") or repo.get("path") or repo.get("path_with_namespace", "").split("/")[-1]


def cmd_list(args) -> int:
    provider = resolve_provider(args.provider, args.host, args.proto)
    repos = provider.list_repos(args.team)

    if not args.include_archived:
        repos = [r for r in repos if not bool(r.get("archived", False))]

    for r in repos:
        name = repo_name(r)
        if name:
            print(name)
    return 0


def cmd_clone_or_sync(args) -> int:
    provider = resolve_provider(args.provider, args.host, args.proto)
    root = pathlib.Path(args.root).expanduser().resolve()

    repos = provider.list_repos(args.team)
    if not args.include_archived:
        repos = [r for r in repos if not bool(r.get("archived", False))]

    eprint(f"Found {len(repos)} repos on {args.provider} host={provider.host} team={args.team}")

    for r in repos:
        name = repo_name(r)
        if not name:
            eprint(f"Skipping repo with no name: {r}")
            continue

        clone_url = provider.pick_clone_url(r)
        dest = root / provider.host / args.team / name

        if args.dry_run:
            print(f"{clone_url} -> {dest}")
        else:
            git_clone_or_fetch(clone_url, dest)

    return 0


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="git-org",
        description="Clone/sync all repos for an org/group into ~/src/<host>/<team>/<repo>.",
        formatter_class=argparse.RawTextHelpFormatter,
    )

    sub = p.add_subparsers(dest="command")

    def add_common(sp):
        sp.add_argument("provider", choices=sorted(PROVIDERS.keys()), help="Provider: github | gitlab")
        sp.add_argument("team", help="GitHub org/user OR GitLab group (id or full path)")
        sp.add_argument("--host", default=None, help="VCS host (default: github.com or gitlab.com)")
        sp.add_argument("--proto", choices=["ssh", "https"], default="ssh", help="Clone protocol (default: ssh)")
        sp.add_argument("--root", default=os.path.expanduser("~/src"), help="Workspace root (default: ~/src)")
        sp.add_argument("--include-archived", action="store_true", help="Include archived repos/projects")
        sp.add_argument("--dry-run", action="store_true", help="Print actions without cloning/fetching")

    sp_clone = sub.add_parser("clone", help="Clone repos; fetch if already cloned")
    add_common(sp_clone)
    sp_clone.set_defaults(func=cmd_clone_or_sync)

    sp_sync = sub.add_parser("sync", help="Alias for clone (fetches existing, clones missing)")
    add_common(sp_sync)
    sp_sync.set_defaults(func=cmd_clone_or_sync)

    sp_list = sub.add_parser("list", help="List repo names for the org/group")
    add_common(sp_list)
    sp_list.set_defaults(func=cmd_list)

    return p


def main(argv: list[str]) -> int:
    parser = build_parser()

    # If no args: show help + exit non-error (nice UX)
    if len(argv) == 0:
        parser.print_help(sys.stdout)
        return 0

    args = parser.parse_args(argv)

    # If subcommand missing: show help
    if not getattr(args, "command", None):
        parser.print_help(sys.stdout)
        return 0

    try:
        return args.func(args)
    except KeyboardInterrupt:
        eprint("Interrupted.")
        return 130
    except Exception as ex:
        eprint(f"Error: {ex}")
        return 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
